+          )
+        : toRedacted(value as string | Redacted.Redacted<string>);
 
 const toRedacted = (
   value: string | Redacted.Redacted<string>,
 ): Redacted.Redacted<string> =>
   Redacted.isRedacted(value)
     ? (value as Redacted.Redacted<string>)
     : Redacted.make(value);
